# Copy to .env at the repo root and fill in ONE provider block. scripts/provision.sh and
# scripts/off.sh read it (scripts/lib/dotenv.sh: parsed, never executed); the provider settings
# become Secret/llm-provider in agentic-netops-agents (scripts/lib/llm_env.sh →
# scripts/lib/intent_secrets.sh). An exported shell variable always overrides the file.
# .env is git-ignored: never commit credentials.

#============================
# Lab Settings
#============================

# The kind cluster (kube context kind-<name>) and the lab's management network.
CLUSTER_NAME=agentic-netops
MGMT_CIDR=172.25.25.0/24

# Seconds every rollout/availability wait may take.
# PROVISION_WAIT_TIMEOUT=300

#============================
# LLM Provider Settings
#============================
# Agentic NetOps uses litellm to manage LLM connections.
# Full list of supported providers: https://docs.litellm.ai/docs/providers
# Note: the model is always LLM_MODEL, regardless of the provider; the prefix before "/" selects
# the provider, and that provider's own variables below hold its key and endpoint.
# Examples:

# OpenAI
# LLM_MODEL="openai/<model_of_choice>"
# OPENAI_API_KEY=<your_openai_api_key>

# OpenAI-compatible gateway (vLLM, llama-swap, LM Studio, a corporate gateway ...)
# OPENAI_BASE_URL is load-bearing here: without it the `openai` provider defaults to
# https://api.openai.com/v1, which rejects gateway keys.
# LLM_MODEL="openai/<model_of_choice>"
# OPENAI_API_KEY=<your_gateway_api_key>
# OPENAI_BASE_URL=<your_gateway_base_url>/v1

# Anthropic
# LLM_MODEL="anthropic/<model_of_choice>"
# ANTHROPIC_API_KEY=<your_anthropic_api_key>

# GROQ
# LLM_MODEL="groq/<model_of_choice>"
# GROQ_API_KEY=<your_groq_api_key>

# Litellm Proxy
# LLM_MODEL="litellm_proxy/<model_of_choice>"
# LITELLM_PROXY_API_BASE=<your_litellm_proxy_base_url>
# LITELLM_PROXY_API_KEY=<your_litellm_proxy_api_key>

# NVIDIA NIM
# LLM_MODEL="nvidia_nim/<model_of_choice>"
# NVIDIA_NIM_API_KEY=<your_nvidia_api_key>
# NVIDIA_NIM_API_BASE=<your_nvidia_nim_endpoint_url>

# Google Gemini
# LLM_MODEL="gemini/<model_of_choice>"
# GEMINI_API_KEY=<your_gemini_api_key>

# Azure OpenAI is not served by this tier's model client (it passes one key and one base URL,
# not an API version): put Azure behind the Litellm Proxy block above.

# The tier's own spelling, AGENTIC_NETOPS_LLM_{MODEL,API_KEY,BASE_URL,GATEWAY}, still works and
# wins over the provider variables. GATEWAY names a shared model gateway and requires a base URL.
# AGENTIC_NETOPS_LLM_MODEL="openai/<model_of_choice>"
# AGENTIC_NETOPS_LLM_API_KEY=<your_api_key>
# AGENTIC_NETOPS_LLM_BASE_URL=<your_base_url>
# AGENTIC_NETOPS_LLM_GATEWAY=<gateway_name>

#============================
# Operator Console
#============================
# The console and the supervisor take a generated credential. The username defaults to
# `operator`; the password is ALWAYS generated (never read from here) and lives in the Secret
# agentic-netops-agents/operator-credentials (docs/operator-guide.md).
# OPERATOR_USERNAME=operator

#============================
# Transport Settings
#============================
# The agents talk A2A over SLIM; the gateway, its TLS material and its credentials are
# provisioned in-cluster (deploy/agents/slim.yaml), so there is nothing to set here.
