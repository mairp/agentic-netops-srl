{
  "srl_nokia-acl:acl": {
    "interface": [
      {
        "interface-id": "ethernet-1/1.310",
        "interface-ref": {
          "interface": "ethernet-1/1",
          "subinterface": 310
        }
      }
    ]
  },
  "srl_nokia-interfaces:interface": [
    {
      "name": "ethernet-1/1",
      "subinterface": [
        {
          "admin-state": "enable",
          "index": 310,
          "l2-mtu": 9412,
          "srl_nokia-interfaces-vlans:vlan": {
            "encap": {
              "single-tagged": {
                "vlan-id": 310
              }
            }
          },
          "type": "srl_nokia-interfaces:bridged"
        }
      ]
    },
    {
      "name": "irb0",
      "subinterface": [
        {
          "admin-state": "enable",
          "anycast-gw": {
            "virtual-router-id": 1
          },
          "index": 310,
          "ip-mtu": 9348,
          "ipv4": {
            "address": [
              {
                "anycast-gw": true,
                "ip-prefix": "10.31.0.1/24"
              }
            ],
            "admin-state": "enable",
            "srl_nokia-interfaces-nbr:arp": {
              "host-route": {
                "populate": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              },
              "learn-unsolicited": true,
              "srl_nokia-interfaces-nbr-evpn:evpn": {
                "advertise": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              }
            },
            "unnumbered": {
              "admin-state": "disable"
            }
          }
        }
      ]
    }
  ],
  "srl_nokia-network-instance:network-instance": [
    {
      "admin-state": "enable",
      "description": "Service gw4 (mac-vrf)",
      "interface": [
        {
          "name": "irb0.310"
        }
      ],
      "name": "ipvrf-gw4",
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "admin-state": "enable",
              "ecmp": 8,
              "encapsulation-type": "vxlan",
              "evi": 10311,
              "id": 1,
              "vxlan-interface": "vxlan0.10311"
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:65000:10311",
                "import-rt": "target:65000:10311"
              }
            }
          ]
        }
      },
      "type": "srl_nokia-network-instance:ip-vrf",
      "vxlan-interface": [
        {
          "name": "vxlan0.10311"
        }
      ]
    },
    {
      "admin-state": "enable",
      "bridge-table": {
        "protect-anycast-gw-mac": true
      },
      "description": "Service gw4 (mac-vrf)",
      "interface": [
        {
          "name": "ethernet-1/1.310"
        },
        {
          "name": "irb0.310"
        }
      ],
      "name": "macvrf-gw4",
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "admin-state": "enable",
              "ecmp": 8,
              "encapsulation-type": "vxlan",
              "evi": 10310,
              "id": 1,
              "vxlan-interface": "vxlan0.10310"
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:65000:10310",
                "import-rt": "target:65000:10310"
              }
            }
          ]
        }
      },
      "type": "srl_nokia-network-instance:mac-vrf",
      "vxlan-interface": [
        {
          "name": "vxlan0.10310"
        }
      ]
    }
  ],
  "srl_nokia-tunnel-interfaces:tunnel-interface": [
    {
      "name": "vxlan0",
      "vxlan-interface": [
        {
          "egress": {
            "source-ip": "use-system-ipv4-address"
          },
          "index": 10310,
          "ingress": {
            "vni": 10310
          },
          "type": "srl_nokia-interfaces:bridged"
        },
        {
          "index": 10311,
          "ingress": {
            "vni": 10311
          },
          "type": "srl_nokia-interfaces:routed"
        }
      ]
    }
  ]
}
