{
  "srl_nokia-acl:acl": {
    "interface": [
      {
        "interface-id": "ethernet-1/1.160",
        "interface-ref": {
          "interface": "ethernet-1/1",
          "subinterface": 160
        }
      }
    ]
  },
  "srl_nokia-interfaces:interface": [
    {
      "name": "ethernet-1/1",
      "subinterface": [
        {
          "admin-state": "enable",
          "index": 160,
          "l2-mtu": 9412,
          "srl_nokia-interfaces-vlans:vlan": {
            "encap": {
              "single-tagged": {
                "vlan-id": 160
              }
            }
          },
          "type": "srl_nokia-interfaces:bridged"
        }
      ]
    },
    {
      "name": "irb0",
      "subinterface": [
        {
          "admin-state": "enable",
          "anycast-gw": {
            "virtual-router-id": 1
          },
          "index": 160,
          "ip-mtu": 9348,
          "ipv4": {
            "address": [
              {
                "anycast-gw": true,
                "ip-prefix": "10.160.0.1/24"
              }
            ],
            "admin-state": "enable",
            "srl_nokia-interfaces-nbr:arp": {
              "host-route": {
                "populate": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              },
              "learn-unsolicited": true,
              "srl_nokia-interfaces-nbr-evpn:evpn": {
                "advertise": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              }
            },
            "unnumbered": {
              "admin-state": "disable"
            }
          },
          "ipv6": {
            "address": [
              {
                "anycast-gw": true,
                "ip-prefix": "2001:db8:160::1/64"
              }
            ],
            "admin-state": "enable",
            "srl_nokia-interfaces-nbr:neighbor-discovery": {
              "host-route": {
                "populate": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              },
              "learn-unsolicited": "global",
              "srl_nokia-interfaces-nbr-evpn:evpn": {
                "advertise": [
                  {
                    "route-type": "dynamic"
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "srl_nokia-network-instance:network-instance": [
    {
      "admin-state": "enable",
      "description": "Service lab-macvrf-gateway (mac-vrf)",
      "interface": [
        {
          "name": "irb0.160"
        }
      ],
      "name": "ipvrf-lab-macvrf-gateway",
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "admin-state": "enable",
              "ecmp": 8,
              "encapsulation-type": "vxlan",
              "evi": 10161,
              "id": 1,
              "vxlan-interface": "vxlan0.10161"
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:65000:10161",
                "import-rt": "target:65000:10161"
              }
            }
          ]
        }
      },
      "type": "srl_nokia-network-instance:ip-vrf",
      "vxlan-interface": [
        {
          "name": "vxlan0.10161"
        }
      ]
    },
    {
      "admin-state": "enable",
      "bridge-table": {
        "protect-anycast-gw-mac": true
      },
      "description": "Service lab-macvrf-gateway (mac-vrf)",
      "interface": [
        {
          "name": "ethernet-1/1.160"
        },
        {
          "name": "irb0.160"
        }
      ],
      "name": "macvrf-lab-macvrf-gateway",
      "protocols": {
        "bgp-evpn": {
          "srl_nokia-bgp-evpn:bgp-instance": [
            {
              "admin-state": "enable",
              "ecmp": 8,
              "encapsulation-type": "vxlan",
              "evi": 10160,
              "id": 1,
              "vxlan-interface": "vxlan0.10160"
            }
          ]
        },
        "srl_nokia-bgp-vpn:bgp-vpn": {
          "bgp-instance": [
            {
              "id": 1,
              "route-target": {
                "export-rt": "target:65000:10160",
                "import-rt": "target:65000:10160"
              }
            }
          ]
        }
      },
      "type": "srl_nokia-network-instance:mac-vrf",
      "vxlan-interface": [
        {
          "name": "vxlan0.10160"
        }
      ]
    }
  ],
  "srl_nokia-tunnel-interfaces:tunnel-interface": [
    {
      "name": "vxlan0",
      "vxlan-interface": [
        {
          "egress": {
            "source-ip": "use-system-ipv4-address"
          },
          "index": 10160,
          "ingress": {
            "vni": 10160
          },
          "type": "srl_nokia-interfaces:bridged"
        },
        {
          "index": 10161,
          "ingress": {
            "vni": 10161
          },
          "type": "srl_nokia-interfaces:routed"
        }
      ]
    }
  ]
}
