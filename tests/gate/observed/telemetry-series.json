      }
    ],
    "evpn_session_state": [
      {
        "labels": [
          "neighbor_peer_address",
          "network_instance_name",
          "otel_scope_name",
          "otel_scope_schema_url",
          "otel_scope_version",
          "source",
          "subscription_name"
        ],
        "name": "srl_nokia_network_instance:network_instance_protocols_srl_nokia_bgp:bgp_neighbor_session_state"
      }
    ]
  },
  "settings": {
    "collector_prometheus_exporter": {
      "translation_strategy": "UnderscoreEscapingWithoutSuffixes"
    },
    "gnmic_event_processors": {
      "vt-scratch-oper-state-to-int": {
        "event-strings": {
          "transforms": [
            {
              "replace": {
                "apply-on": "value",
                "new": "1",
                "old": "^up$"
              }
            },
            {
              "replace": {
                "apply-on": "value",
                "new": "0",
                "old": "^down$"
              }
            }
          ],
          "value-names": [
            ".*oper-state$"
          ]
        }
      },
      "vt-scratch-session-state-to-int": {
        "event-strings": {
          "transforms": [
            {
              "replace": {
                "apply-on": "value",
                "new": "5",
                "old": "^established$"
              }
            },
            {
              "replace": {
                "apply-on": "value",
                "new": "4",
                "old": "^openconfirm$"
              }
            },
            {
              "replace": {
                "apply-on": "value",
                "new": "3",
                "old": "^opensent$"
              }
            },
            {
              "replace": {
                "apply-on": "value",
                "new": "2",
                "old": "^active$"
              }
            },
            {
              "replace": {
                "apply-on": "value",
                "new": "1",
                "old": "^connect$"
              }
            },
            {
              "replace": {
                "apply-on": "value",
                "new": "0",
                "old": "^idle$"
              }
            }
          ],
          "value-names": [
            ".*session-state$"
          ]
        }
      },
      "vt-scratch-state-as-int": {
        "event-convert": {
          "type": "int",
          "value-names": [
            ".*session-state$",
            ".*oper-state$"
          ]
        }
      }
    },
    "gnmic_otlp_output": {
      "append-subscription-name": false,
      "counter-patterns": [],
      "event-processors": [
        "vt-scratch-session-state-to-int",
        "vt-scratch-oper-state-to-int",
        "vt-scratch-state-as-int"
      ],
      "metric-prefix": "",
      "protocol": "grpc",
      "strings-as-attributes": false,
      "strip-leading-underscore": true,
      "type": "otlp"
    }
  }
}
