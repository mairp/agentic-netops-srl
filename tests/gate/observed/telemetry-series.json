        ],
        "name": "srl_nokia_network_instance:network_instance_protocols_srl_nokia_bgp:bgp_neighbor_afi_safi_oper_state"
      }
    ],
    "evpn_received_routes": [
      {
        "afi_safi_values": [
          "evpn",
          "ipv4-unicast"
        ],
        "labels": [
          "afi_safi_afi_safi_name",
          "neighbor_peer_address",
          "network_instance_name",
          "otel_scope_name",
