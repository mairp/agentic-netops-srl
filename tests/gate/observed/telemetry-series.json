{
  "all_series": [
    "srl_nokia_network_instance:network_instance_protocols_bgp_evpn_srl_nokia_bgp_evpn:bgp_instance_evi",
    "srl_nokia_network_instance:network_instance_protocols_bgp_evpn_srl_nokia_bgp_evpn:bgp_instance_oper_state",
    "srl_nokia_network_instance:network_instance_protocols_srl_nokia_bgp:bgp_neighbor_afi_safi_oper_state",
    "srl_nokia_network_instance:network_instance_protocols_srl_nokia_bgp:bgp_neighbor_afi_safi_received_routes",
    "srl_nokia_network_instance:network_instance_protocols_srl_nokia_bgp:bgp_neighbor_session_state"
  ],
  "observed_with": {
    "collector_image": "docker.io/otel/opentelemetry-collector-contrib:0.161.0@sha256:fd328de2552466ad78385e1b1289c3f2402b1c45f265b252aab1955b42845ac1",
    "encoding": "json_ietf",
    "gnmic_image": "ghcr.io/openconfig/gnmic:0.47.0@sha256:fd59f5f1c7a98e14ff5b14f85329e5e0a4d49ef1d5b0dddfd910b6caef03b9fb",
    "subscription_mode": "stream/sample 10s",
    "subscription_paths": [
      "/network-instance[name=default]/protocols/bgp/neighbor[peer-address=*]/session-state",
      "/network-instance[name=default]/protocols/bgp/neighbor[peer-address=*]/afi-safi[afi-safi-name=*]/received-routes",
      "/network-instance[name=default]/protocols/bgp/neighbor[peer-address=*]/afi-safi[afi-safi-name=*]/oper-state",
      "/network-instance[name=*]/protocols/bgp-evpn/bgp-instance[id=*]/evi",
      "/network-instance[name=*]/protocols/bgp-evpn/bgp-instance[id=*]/oper-state"
    ]
  },
  "schema": "agentic-netops.gate.telemetry-series/v1",
  "series": {
    "bgp_evpn_instance_evi": [
      {
        "labels": [
          "bgp_instance_id",
          "network_instance_name",
          "otel_scope_name",
          "otel_scope_schema_url",
