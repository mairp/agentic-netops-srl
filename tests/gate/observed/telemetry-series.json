        ],
        "name": "srl_nokia_network_instance:network_instance_protocols_bgp_evpn_srl_nokia_bgp_evpn:bgp_instance_oper_state"
      }
    ],
    "evpn_family_oper_state": [
      {
        "afi_safi_values": [
          "evpn",
          "ipv4-unicast",
