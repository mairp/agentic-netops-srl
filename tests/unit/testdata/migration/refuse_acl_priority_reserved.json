{
  "serviceId": "3e6c0a2b4d9f1c5",
  "type": "acl",
  "tenant": "acme",
  "acl": {
    "name": "web-ingress",
    "stage": "ingress",
    "type": "ipv4",
    "defaultAction": "deny",
    "rules": [
      {
        "name": "allow-https",
        "priority": 100,
        "action": "permit",
        "protocol": "tcp",
        "sourcePrefix": "10.0.0.0/24",
        "destinationPort": "443",
        "description": "operator https allowance"
      },
      {
        "name": "deny-rest",
        "priority": 65535,
        "action": "deny"
      }
    ]
  },
  "endpoints": [
    {
      "node": "leaf01",
      "attachment": "ethernet-1/1",
      "vlan": 100
    }
  ]
}
