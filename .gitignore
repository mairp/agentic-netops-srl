/bin/
.evidence/

*.log
.env

# Toolchain-local state.
agents/.venv/
ui/node_modules/
ui/dist/
ui/.test-build/
__pycache__/
.pytest_cache/
.ruff_cache/

# containerlab runtime lab directory (device-generated configs and certificates)
lab/clab-*/

# stray `go build` output at the repository root (built binaries belong in bin/)
/intent-translator

# Not part of the lab: spec-kit tooling, the walkthrough recorder and local debug captures.
.specify/
testautomation/
debug/
