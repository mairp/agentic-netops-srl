# ui — the intent tier's browser chat surface (T086; NFR-003, data-model.md §26).
# Build context: ui/ (versions.lock.yaml firstPartyImages[ui]). The one external image is
# node:20.20.2-alpine (track 20-alpine) by the digest the lock records (make verify-pins checks it);
# the runtime stage builds FROM the earlier stage `base`, so the FROM list stays the lock's from[].
# Dependencies: exactly ui/package-lock.json (`npm ci` — the lock's versions and integrity hashes,
# nothing resolved). The runtime stage carries only the built static files and a dependency-free
# static server on 3000 (contracts/kubernetes-objects.md: Service ui 3000); the API base URL is
# deployment configuration (ConfigMap ui-env), never baked in. The ui Deployment arrives with a
# later story; this image is built and tagged <name>:<contentHash> by scripts/lib/image_build.sh.

FROM node:20.20.2-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS base
ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

FROM base AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build

FROM base
WORKDIR /srv
COPY --from=build /src/dist/ /srv/dist/
# A static server with no dependency: serves /srv/dist, index.html for unknown paths (a single-page
# application), and nothing outside dist.
RUN printf '%s\n' \
  "import http from 'node:http';" \
  "import fs from 'node:fs';" \
  "import path from 'node:path';" \
  "const root = '/srv/dist';" \
  "const types = {'.html':'text/html; charset=utf-8','.js':'text/javascript','.css':'text/css','.json':'application/json','.svg':'image/svg+xml','.png':'image/png','.ico':'image/x-icon','.map':'application/json'};" \
  "http.createServer((req, res) => {" \
  "  if (req.method !== 'GET' && req.method !== 'HEAD') { res.writeHead(405); res.end(); return; }" \
  "  const url = new URL(req.url, 'http://ui');" \
  "  if (url.pathname === '/healthz') { res.writeHead(200, {'content-type':'text/plain'}); res.end('ok'); return; }" \
  "  let file = path.normalize(path.join(root, decodeURIComponent(url.pathname)));" \
  "  if (file !== root && !file.startsWith(root + '/')) { res.writeHead(400); res.end(); return; }" \
  "  if (!fs.existsSync(file) || fs.statSync(file).isDirectory()) file = path.join(root, 'index.html');" \
  "  res.writeHead(200, {'content-type': types[path.extname(file)] || 'application/octet-stream', 'x-content-type-options': 'nosniff'});" \
  "  if (req.method === 'HEAD') { res.end(); return; }" \
  "  fs.createReadStream(file).pipe(res);" \
  "}).listen(3000, '0.0.0.0');" \
  > /srv/server.mjs
USER 1000:1000
EXPOSE 3000
ENTRYPOINT ["node", "/srv/server.mjs"]
