# ui — the intent tier's browser chat surface (T086; NFR-003, data-model.md §26).
# Build context: ui/ (versions.lock.yaml firstPartyImages[ui]). The one external image is
# node:20.20.2-alpine (track 20-alpine) by the digest the lock records (make verify-pins checks it);
# the runtime stage builds FROM the earlier stage `base`, so the FROM list stays the lock's from[].
# Dependencies: exactly ui/package-lock.json (`npm ci` — the lock's versions and integrity hashes,
# nothing resolved). The runtime stage carries only the built static files and ui/server.mjs, a
# dependency-free static server and /api proxy on 3000 (contracts/kubernetes-objects.md: Service
# ui 3000); the supervisor base URL is deployment configuration (SUPERVISOR_BASE_URL from ConfigMap
# ui-env), never baked in. This image is built and tagged <name>:<contentHash> by
# scripts/lib/image_build.sh.

FROM node:20.20.2-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS base
ENV NODE_ENV=production \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false

FROM base AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY . .
RUN npm run build

FROM base
WORKDIR /srv
COPY --from=build /src/dist/ /srv/dist/
# ui/server.mjs — dependency-free (node:http only): serves /srv/dist (index.html for unknown paths,
# a single-page application, nothing outside dist), /healthz for the probes, and proxies the five
# supervisor routes under same-origin /api/<route> to ${SUPERVISOR_BASE_URL}/<route> (ConfigMap
# ui-env), streaming the NDJSON body through unbuffered and forwarding Authorization untouched. It
# refuses to start without SUPERVISOR_BASE_URL.
COPY --from=build /src/server.mjs /srv/server.mjs
USER 1000:1000
EXPOSE 3000
ENTRYPOINT ["node", "/srv/server.mjs"]
