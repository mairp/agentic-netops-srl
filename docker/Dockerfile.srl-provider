# srl-provider — the SR Linux provider (T042; data-model.md §26, NFR-003).
# Every FROM is pinned by the digest versions.lock.yaml firstPartyImages[srl-provider]
# records (make verify-pins checks it); the image is tagged with the content hash of
# its build context by scripts/lib/image_build.sh (T169) and run with
# imagePullPolicy: Never. Build context: the repository root.

FROM golang:1.27.1-alpine@sha256:4cb7ac979db5fcc41cae44b2227ba5ab8a51e8807f40d9ba4dee20a0ad960b5b AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY api/ api/
COPY cmd/ cmd/
COPY controllers/ controllers/
COPY internal/ internal/
COPY pkg/ pkg/
RUN go build -ldflags="-s -w" -o /out/srl-provider ./cmd/srl-provider

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
# The compatibility set the provider asserts and publishes is the lock file of the
# tree it was built from (internal/compat): it is part of the build context, so the
# content-hash tag covers it.
COPY versions.lock.yaml /etc/srl-provider/versions.lock.yaml
COPY --from=build /out/srl-provider /usr/local/bin/srl-provider
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/srl-provider"]
