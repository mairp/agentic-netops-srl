# allocator — the intent tier's allocator image (T086; NFR-003, data-model.md §26).
# Build context: agents/ (versions.lock.yaml firstPartyImages[allocator]). The one external image is
# python:3.13.0-slim by the digest the lock records (make verify-pins checks it; never typed by hand —
# written by scripts/lib/resolve_pins.sh). The later stages build FROM the earlier stage `base`, so
# the FROM list stays exactly the lock's from[].
# Dependencies: exactly agents/uv.lock — `uv sync --frozen --no-dev` installs the locked versions and
# verifies every artefact against the lock's hashes; nothing is resolved at build time. uv itself is
# the version that wrote the lock, pinned by version and discarded with the build stage.
# Tagged <name>:<contentHash> by scripts/lib/image_build.sh (T169) and run with imagePullPolicy: Never.

FROM python:3.13.0-slim@sha256:0de818129b26ed8f46fd772f540c80e277b67a28229531a1ba0fdacfaed19bcb AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

FROM base AS build
ARG UV_VERSION=0.11.20
RUN pip install "uv==${UV_VERSION}"
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON=/usr/local/bin/python3.13 \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_CACHE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

FROM base
# A fixed non-root identity; the Deployment's securityContext asserts the same numbers.
RUN groupadd --system --gid 10001 agent \
 && useradd --system --uid 10001 --gid agent --no-create-home --home-dir /tmp --shell /usr/sbin/nologin agent
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY config/ config/
COPY common/ common/
COPY provisioning/ provisioning/
COPY supervisors/ supervisors/
# HOME=/tmp: slim_bindings creates its storage directory under $HOME (Slim.new fails without a
# writable one); the Deployment mounts an emptyDir at /tmp under readOnlyRootFilesystem.
ENV PATH=/app/.venv/bin:$PATH \
    PYTHONPATH=/app \
    HOME=/tmp \
    AGENT_COMPONENT=allocator
USER 10001:10001
EXPOSE 9091
ENTRYPOINT ["python", "-m", "provisioning.allocator.server"]
