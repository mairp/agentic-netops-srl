# intent-translator — the translator sidecar of the deployer pod (T097; contracts/translator-api.md;
# data-model.md §26, NFR-003). Every FROM is pinned by the digest versions.lock.yaml
# firstPartyImages[intent-translator] records (make verify-pins checks it); the image is tagged with
# the content hash of its build context by scripts/lib/image_build.sh (T169) and run with
# imagePullPolicy: Never. Build context: the repository root. It carries pkg/migration and nothing
# of a cluster client; busybox's wget in the runtime layer serves the pod's exec probes.

FROM golang:1.27.1-alpine@sha256:4cb7ac979db5fcc41cae44b2227ba5ab8a51e8807f40d9ba4dee20a0ad960b5b AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download && go mod verify
COPY cmd/intent-translator/ cmd/intent-translator/
COPY internal/telemetry/jsonlog/ internal/telemetry/jsonlog/
COPY pkg/migration/ pkg/migration/
RUN go build -ldflags="-s -w" -o /out/intent-translator ./cmd/intent-translator

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
COPY --from=build /out/intent-translator /usr/local/bin/intent-translator
USER 65532:65532
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/intent-translator"]
CMD ["--listen", "127.0.0.1:8090"]
