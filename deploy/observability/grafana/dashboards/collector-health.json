        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count without (job, instance, subscription_name, otel_scope_name, otel_scope_version, otel_scope_schema_url) (label_replace({__name__=~\"srl_nokia_.+\"}, \"series_name\", \"$1\", \"__name__\", \"(.+)\")) > 1) or vector(0)",
