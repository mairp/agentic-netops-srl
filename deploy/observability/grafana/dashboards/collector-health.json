      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "otel_scope_name": true,
              "otel_scope_schema_url": true,
              "otel_scope_version": true,
              "subscription_name": true,
              "job": true,
              "instance": true
