    "agentic-netops",
    "collector",
    "pipeline"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": []
  },
