    {
      "type": "table",
      "title": "Seconds without device samples, per node",
      "description": "The gap size an outage left within the range, sampled every 30 s: per node (source) from its interface state series, and for the devices scrape itself (instance).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "$__range_s - 30 * count_over_time((max by (source) (@@series:interface_oper_state@@))[$__range:30s])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "$__range_s - 30 * count_over_time((max by (instance) (up{job=\"devices\"} == 1))[$__range:30s])",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "otel_scope_name": true,
              "otel_scope_schema_url": true,
              "otel_scope_version": true,
              "subscription_name": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "Value #A": "gap (node series)",
              "Value #B": "gap (devices scrape)"
            }
          }
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 15
