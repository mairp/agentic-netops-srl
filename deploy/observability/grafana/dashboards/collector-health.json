    {
      "type": "stat",
      "title": "Points refused / failed over the range",
      "description": "Collector metric points refused or failed on receive plus failed on export within the range (OtlpDataPointsRejected).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(increase(@@series:otelcol_receiver_refused@@[$__range])) or vector(0)) + (sum(increase(@@series:otelcol_receiver_failed@@[$__range])) or vector(0)) + (sum(increase(@@series:otelcol_exporter_send_failed@@[$__range])) or vector(0))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 10
      }
    },
