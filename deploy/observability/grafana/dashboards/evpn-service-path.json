  "uid": "agentic-netops-evpn-service-path",
  "title": "EVPN service path",
  "description": "T132 (FR-094, evidence/06-telemetry-visualization.md §8.2): for one mac-vrf / ip-vrf — the leaf-to-leaf tunnel path (each leaf carrying the instance and the remote VTEPs its VNI floods to, a VTEP resolved to its node through the node's system0 address), per-VTEP tunnel statistics, per-VNI MAC counts, the routed instance's route counts and the hit counters of the access lists bound to the service (acl-<service>-ingress / -egress, internal/model/names.go).",
  "tags": [
    "agentic-netops",
    "evpn",
    "service"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "utc",
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(@@series:network_instance_oper_state@@{network_instance_name=~\"(vlan|macvrf|ipvrf)-.+\"}, network_instance_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(@@series:network_instance_oper_state@@{network_instance_name=~\"(vlan|macvrf|ipvrf)-.+\"}, network_instance_name)",
        "regex": "",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "service_id",
        "label": "Service id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(@@series:network_instance_oper_state@@{network_instance_name=\"$service\"}, network_instance_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(@@series:network_instance_oper_state@@{network_instance_name=\"$service\"}, network_instance_name)",
        "regex": "/^(?:vlan|macvrf|ipvrf)-(.+)$/",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 2,
        "current": {},
        "options": []
      },
      {
        "name": "vni",
        "label": "VNI",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(@@series:network_instance_vxlan_interface_oper_state@@{network_instance_name=\"$service\"}, vxlan_interface_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(@@series:network_instance_vxlan_interface_oper_state@@{network_instance_name=\"$service\"}, vxlan_interface_name)",
        "regex": "/^[^.]+\\.([0-9]+)$/",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "hide": 0,
        "current": {},
        "options": [],
        "allValue": null
      }
    ]
  },
  "panels": [
