        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (source) (@@series:bgp_evpn_instance_oper_state@@{network_instance_name=\"$service\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
