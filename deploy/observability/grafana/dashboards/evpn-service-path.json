    {
      "type": "state-timeline",
      "title": "Tunnel path over time",
      "description": "Each leaf-to-leaf path of the service over time; a path that disappears is a lost remote VTEP.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (source, peer, vtep_address) ((@@series:vxlan_vtep_index@@ * on (vtep_address) group_left (peer) max by (vtep_address, peer) (label_replace(label_replace(@@series:subif_ipv4_address_status@@{interface_name=\"system0\"}, \"vtep_address\", \"$1\", \"address_ip_prefix\", \"(.+)/32\"), \"peer\", \"$1\", \"source\", \"(.+)\"))) and on (source) @@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"} and on (peer) label_replace(@@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"}, \"peer\", \"$1\", \"source\", \"(.+)\"))",
          "legendFormat": "{{source}} → {{peer}} ({{vtep_address}})",
          "range": true,
