              "otel_scope_schema_url": true,
              "otel_scope_version": true,
              "subscription_name": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "source": "leaf",
              "peer": "remote leaf",
              "destination_vtep": "remote VTEP",
              "destination_vni": "VNI",
              "Value": "destinations"
