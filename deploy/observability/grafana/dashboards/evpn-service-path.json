      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "8 * rate(@@series:vxlan_vtep_out_octets@@[$__rate_interval]) and on (source, vtep_address) count by (source, peer, vtep_address) ((@@series:vxlan_vtep_index@@ * on (vtep_address) group_left (peer) max by (vtep_address, peer) (label_replace(label_replace(@@series:subif_ipv4_address_status@@{interface_name=\"system0\"}, \"vtep_address\", \"$1\", \"address_ip_prefix\", \"(.+)/32\"), \"peer\", \"$1\", \"source\", \"(.+)\"))) and on (source) @@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"} and on (peer) label_replace(@@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"}, \"peer\", \"$1\", \"source\", \"(.+)\"))",
          "legendFormat": "{{source}} → {{vtep_address}} out",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "8 * rate(@@series:vxlan_vtep_in_octets@@[$__rate_interval]) and on (source, vtep_address) count by (source, peer, vtep_address) ((@@series:vxlan_vtep_index@@ * on (vtep_address) group_left (peer) max by (vtep_address, peer) (label_replace(label_replace(@@series:subif_ipv4_address_status@@{interface_name=\"system0\"}, \"vtep_address\", \"$1\", \"address_ip_prefix\", \"(.+)/32\"), \"peer\", \"$1\", \"source\", \"(.+)\"))) and on (source) @@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"} and on (peer) label_replace(@@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"}, \"peer\", \"$1\", \"source\", \"(.+)\"))",
          "legendFormat": "{{source}} ← {{vtep_address}} in",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
