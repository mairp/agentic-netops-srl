        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Leaf-to-leaf tunnel path",
      "description": "Per leaf (source) carrying $service: each remote VTEP it holds whose node (the owner of that system0 address) carries $service too — the leaf-to-leaf VXLAN tunnels the service can use.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (source, peer, vtep_address) ((@@series:vxlan_vtep_index@@ * on (vtep_address) group_left (peer) max by (vtep_address, peer) (label_replace(label_replace(@@series:subif_ipv4_address_status@@{interface_name=\"system0\"}, \"vtep_address\", \"$1\", \"address_ip_prefix\", \"(.+)/32\"), \"peer\", \"$1\", \"source\", \"(.+)\"))) and on (source) @@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"} and on (peer) label_replace(@@series:bgp_evpn_instance_evi@@{network_instance_name=\"$service\"}, \"peer\", \"$1\", \"source\", \"(.+)\"))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "otel_scope_name": true,
              "otel_scope_schema_url": true,
              "otel_scope_version": true,
              "subscription_name": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "source": "leaf",
              "peer": "remote leaf",
              "vtep_address": "remote VTEP",
              "Value": "tunnels"
            }
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "table",
      "title": "Flood list per VNI (mac-vrf)",
      "description": "A mac-vrf's BUM destinations per VNI (vxlan-interface index = VNI) and the node owning each destination VTEP; empty for an ip-vrf, which floods nothing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count by (source, peer, destination_vtep, destination_vni) (@@series:vxlan_multicast_destination@@{vxlan_interface_index=~\"$vni\"} * on (destination_vtep) group_left (peer) max by (destination_vtep, peer) (label_replace(label_replace(@@series:subif_ipv4_address_status@@{interface_name=\"system0\"}, \"destination_vtep\", \"$1\", \"address_ip_prefix\", \"(.+)/32\"), \"peer\", \"$1\", \"source\", \"(.+)\")))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
