    {
      "type": "timeseries",
      "title": "VTEP traffic (bits/s)",
      "description": "Tunnel-endpoint counters of the VTEPs on this service's path (the tunnel endpoint carries the packet counters; a VTEP is shared by every service between the same two leaves).",
