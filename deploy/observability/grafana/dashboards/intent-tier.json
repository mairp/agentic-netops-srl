  {
   "id": 9,
   "type": "table",
   "title": "Services created by conversation",
   "description": "agentic_netops_agent_service_info: one row per tier-submitted Network. service_id is the Network name without the migr- prefix (controllers/network/intent.go ServiceID), service the device network-instance the fabric service view selects (vlan-/macvrf-/ipvrf-<service_id>, internal/model/names.go). Row links: this dashboard for the conversation, the fabric service view for the service — neither carries a time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 7,
    "w": 24,
    "x": 0,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "label_replace(label_replace(label_replace(label_join(label_replace(agentic_netops_agent_service_info, \"service_id\", \"$1\", \"network\", \"(?:migr-)?(.+)\"), \"k\", \"|\", \"construct\", \"service_id\"), \"service\", \"vlan-$1\", \"k\", \"vlan[|](.+)\"), \"service\", \"macvrf-$1\", \"k\", \"mac-vrf[|](.+)\"), \"service\", \"ipvrf-$1\", \"k\", \"ip-vrf[|](.+)\")",
     "legendFormat": "",
     "range": false,
     "instant": true,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "links": [
      {
       "title": "Conversation trace (${__data.fields.correlation_id})",
       "url": "/d/intent-tier/intent-tier?var-correlation_id=${__data.fields.correlation_id}"
      },
      {
       "title": "Fabric service view (${__data.fields.service})",
       "url": "/d/agentic-netops-evpn-service-path/evpn-service-path?var-service=${__data.fields.service}&var-service_id=${__data.fields.service_id}"
      }
     ]
    },
    "overrides": []
   },
   "transformations": [
    {
     "id": "filterFieldsByName",
     "options": {
      "include": {
       "names": [
        "correlation_id",
        "network",
        "namespace",
        "construct",
        "service_id",
        "service"
       ]
      }
     }
    },
    {
     "id": "organize",
     "options": {
      "indexByName": {
       "correlation_id": 0,
       "network": 1,
       "namespace": 2,
       "construct": 3,
       "service_id": 4,
       "service": 5
      }
     }
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
  {
   "id": 10,
   "type": "table",
   "title": "Conversation trace — $correlation_id",
   "description": "Every span of the trace whose id is the correlation id, from the agent-analytics store (ClickHouse otel.otel_traces, datasource agent-analytics), oldest first. Filtered on TraceId only — no time filter: a conversation is found whatever the dashboard range. The failing stage carries status Error, its reason and the payload that failed validation. Row link: the fabric service view of the Network the conversation converged (k8s.network.name on the convergence span; the device instance prefix from agentic_netops.construct, mac-vrf when the trace names none), without a time range.",
   "datasource": {
    "type": "mysql",
    "uid": "agent-analytics"
   },
   "gridPos": {
    "h": 12,
    "w": 24,
    "x": 0,
    "y": 13
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "agent-analytics"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "WITH t AS (\n  SELECT anyIf(SpanAttributes['k8s.network.name'], SpanAttributes['k8s.network.name'] != '') AS network,\n         anyIf(SpanAttributes['agentic_netops.construct'], SpanAttributes['agentic_netops.construct'] != '') AS construct\n  FROM otel.otel_traces WHERE TraceId = '$correlation_id')\nSELECT Timestamp,\n       ServiceName AS service_name,\n       SpanName AS span_name,\n       SpanAttributes['agentic_netops.stage'] AS stage,\n       StatusCode AS status_code,\n       SpanAttributes['agentic_netops.failure.reason'] AS failure_reason,\n       SpanAttributes['agentic_netops.failure.payload'] AS failure_payload,\n       round(Duration / 1000000, 3) AS duration_ms,\n       arrayStringConcat(Events.Name, ', ') AS audit_events,\n       TraceId AS correlation_id,\n       t.network AS network,\n       replaceRegexpOne(t.network, '^migr-', '') AS service_id,\n       multiIf(t.network = '', '', t.construct = 'vlan', concat('vlan-', service_id),\n               t.construct = 'ip-vrf', concat('ipvrf-', service_id), concat('macvrf-', service_id)) AS service\nFROM otel.otel_traces CROSS JOIN t\nWHERE TraceId = '$correlation_id'\nORDER BY Timestamp"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "links": [
      {
       "title": "Fabric service view (${__data.fields.service})",
       "url": "/d/agentic-netops-evpn-service-path/evpn-service-path?var-service=${__data.fields.service}&var-service_id=${__data.fields.service_id}"
      }
     ]
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "duration_ms"
      },
      "properties": [
       {
        "id": "unit",
        "value": "ms"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "status_code"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "Error": {
            "color": "red",
            "index": 0
           },
           "STATUS_CODE_ERROR": {
            "color": "red",
            "index": 1
           }
          }
         }
        ]
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "failure_payload"
      },
      "properties": [
       {
        "id": "custom.inspect",
        "value": true
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   }
  },
